# Copy to .env.local (git-ignored) and fill in real values.
# Never commit real credentials. Never prefix a server-only secret with NEXT_PUBLIC_/VITE_.

# --- Runtime ---
NODE_ENV=development
PORT=4173

# --- Database (server-only) ---
# DATABASE_URL="postgresql://user:password@localhost:5432/app?schema=public"

# --- Auth (server-only) ---
# AUTH_SECRET="generate with: openssl rand -base64 32"
# SESSION_COOKIE_NAME="session"

# --- Field encryption (server-only) ---
# 32-byte AES-256 key, base64. Encrypts IC numbers, addresses and salaries at rest.
# FIELD_ENCRYPTION_KEY="generate with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
# Separate key for the deterministic blind index used by equality lookups.
# FIELD_INDEX_KEY="generate with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""

# --- Third-party APIs (server-only) ---
# API_KEY=""

# --- Public values (safe to expose to the browser) ---
# PUBLIC_APP_URL="http://localhost:4173"
